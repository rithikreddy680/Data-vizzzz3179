{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Combined dashboard: Queensland crash map, monthly crashes by severity, and top LGAs by crash count. Shared legend selection (severity) and casualties filter.",
  "config": {
    "view": { "stroke": null },
    "title": {
      "font": "Segoe UI",
      "fontSize": 22,
      "fontWeight": 600,
      "color": "#0f172a",
      "offset": 12,
      "subtitleFont": "Segoe UI",
      "subtitleFontSize": 13,
      "subtitleColor": "#334155",
      "subtitlePadding": 6
    },
    "legend": {
      "orient": "bottom",
      "labelFont": "Segoe UI",
      "labelFontSize": 12,
      "titleFont": "Segoe UI",
      "titleFontSize": 12,
      "padding": 10
    },
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelPadding": 4
    },
    "concat": { "spacing": 8 },
    "padding": 4,
    "autosize": { "type": "fit", "contains": "padding", "resize": true }
  },
  "params": [
    {
      "name": "sevTop",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Fatal", "Hospital", "Medical", "Minor", "Property"],
        "labels": ["All severities", "Fatal", "Hospitalisation", "Medical Treatment", "Minor Injury", "Property Damage Only"],
        "name": "Severity: ",
        "element": "#controls"
      }
    },
    {
      "name": "lgaSelect",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Brisbane",
          "Gold Coast",
          "Sunshine Coast",
          "Logan",
          "Moreton Bay",
          "Townsville",
          "Cairns",
          "Ipswich",
          "Toowoomba",
          "Redland",
          "Mackay",
          "Rockhampton",
          "Bundaberg",
          "Fraser Coast",
          "Noosa",
          "Gladstone",
          "Gympie",
          "Scenic Rim",
          "Whitsunday",
          "Central Highlands"
        ],
        "name": "LGA: ",
        "element": "#controls"
      }
    },
    {
      "name": "typeFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All","Single vehicle","Multiple vehicle","Pedestrian"],
        "name": "Crash Type: ",
        "element": "#controls"
      }
    },
    {
      "name": "natureFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All","Angle","Sideswipe","Head-on","Rear-end","Hit object","Rollover","Other"],
        "name": "Crash Nature: ",
        "element": "#controls"
      }
    },
    {
      "name": "casBucket",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "1", "2-5", "5-10", "10-15", "15-20", "20+"],
        "labels": ["All casualties", "1", "2-5", "5-10", "10-15", "15-20", "20+"],
        "name": "Casualties: ",
        "element": "#controls"
      }
    },
    {
      "name": "yearStart",
      "value": 2001,
      "bind": { "input": "range", "name": "Year from: ", "min": 2001, "max": 2021, "step": 1, "element": "#controls-years" }
    },
    {
      "name": "yearEnd",
      "value": 2021,
      "bind": { "input": "range", "name": "Year to: ", "min": 2001, "max": 2021, "step": 1, "element": "#controls-years" }
    }
  ],
  "hconcat": [
    {
      "width": 400,
      "height": 550,
      "title": {
        "text": "Crash Locations Across Queensland",
        "anchor": "start",
        "subtitle": [
          "Dots = crashes; size = casualties; color = severity. Use top controls to filter and the legend to highlight.",
          "Why: Reveal hotspots. Look for clusters near cities/corridors, severe (red/orange) points, and large dots."
        ]
      },
      "projection": { "type": "mercator" },
      "layer": [
        {
          "name": "queensland-outline",
          "data": {
            "url": "data/QLD_simplified.topojson",
            "format": { "type": "topojson", "feature": "QLD_STATE_POLYGON_shp_GDA2020" }
          },
          "mark": { "type": "geoshape", "fill": "#e6f2ff", "stroke": "#2563eb", "strokeWidth": 1.2 }
        },
        {
          "name": "crash-points",
          "data": { "url": "data/crash_data_queensland_1_crash_locations_trimmed.csv" },
          
          "transform": [
            { "filter": "isValid(datum.Crash_Longitude) && isValid(datum.Crash_Latitude)" },
            { "filter": "datum.Crash_Longitude >= 137 && datum.Crash_Longitude <= 155 && datum.Crash_Latitude >= -29.5 && datum.Crash_Latitude <= -9" },
            { "calculate": "toNumber(datum.Crash_Year)", "as": "YearNum" },
            { "calculate": "indexof(lower(datum.Crash_Severity), 'fatal')>=0 ? 'Fatal' : indexof(lower(datum.Crash_Severity), 'hospital')>=0 ? 'Hospital' : indexof(lower(datum.Crash_Severity), 'medical')>=0 ? 'Medical' : indexof(lower(datum.Crash_Severity), 'minor')>=0 ? 'Minor' : 'Property'", "as": "SeverityNorm" },
            { "filter": "isValid(datum.YearNum) && datum.YearNum >= yearStart && datum.YearNum <= yearEnd" },
            { "filter": "sevTop == 'All' || datum.SeverityNorm == sevTop" },
            { "filter": "(lgaSelect == 'All' || indexof(lower(datum.Loc_Local_Government_Area), lower(lgaSelect)) >= 0)" },
            { "filter": "typeFilter == 'All' || indexof(lower(datum.Crash_Type), lower(typeFilter)) >= 0" },
            { "filter": "natureFilter == 'All' || indexof(lower(datum.Crash_Nature), lower(natureFilter)) >= 0" },
            { "calculate": "floor(toNumber(datum.Count_Casualty_Total))", "as": "CasTotalInt" },
            { "filter": "casBucket == 'All' || (casBucket == '1' && datum.CasTotalInt == 1) || (casBucket == '2-5' && datum.CasTotalInt >= 2 && datum.CasTotalInt <= 5) || (casBucket == '5-10' && datum.CasTotalInt >= 5 && datum.CasTotalInt <= 10) || (casBucket == '10-15' && datum.CasTotalInt >= 10 && datum.CasTotalInt <= 15) || (casBucket == '15-20' && datum.CasTotalInt >= 15 && datum.CasTotalInt <= 20) || (casBucket == '20+' && datum.CasTotalInt >= 20)" }
          ],
          "mark": { "type": "circle" },
          "encoding": {
            "longitude": { "field": "Crash_Longitude", "type": "quantitative" },
            "latitude": { "field": "Crash_Latitude", "type": "quantitative" },
            "size": {
              "field": "CasTotalInt",
              "type": "quantitative",
              "title": "Casualties (size)",
              "scale": { "domain": [1, 25], "range": [30, 600] },
              "legend": { "values": [1, 2, 3, 4, 5, 10, 15, 20], "format": ",d", "symbolType": "circle", "orient": "left" }
            },
            "color": {
              "field": "SeverityNorm",
              "type": "nominal",
              "title": "Severity",
              "scale": {
                "domain": ["Fatal", "Hospital", "Medical", "Minor", "Property"],
                "range": ["#dc2626", "#f97316", "#22c55e", "#3b82f6", "#94a3b8"]
              },
              "legend": {
                "orient": "right",
                "direction": "vertical",
                "symbolType": "circle",
                "symbolSize": 120,
                "padding": 8,
                "columns": 1,
                "values": ["Fatal", "Hospital", "Medical", "Minor", "Property"]
              }
            },
            "opacity": { "value": 0.9 },
            "tooltip": [
              { "field": "Crash_Ref_Number", "title": "Ref" },
              { "field": "SeverityNorm", "title": "Severity" },
              { "field": "Crash_Year", "title": "Year" },
              { "field": "Crash_Month", "title": "Month" },
              { "field": "Crash_Day_Of_Week", "title": "Day" },
              { "field": "Crash_Nature", "title": "Nature" },
              { "field": "Crash_Type", "title": "Type" },
              { "field": "Loc_Suburb", "title": "Suburb" },
              { "field": "Loc_Local_Government_Area", "title": "LGA" },
              { "field": "CasTotalInt", "title": "Total casualties", "format": ",d" }
            ]
          }
        }
      ]
    },
    {
      "vconcat": [
        {
          "width": 400,
          "height": 220,
          "data": { "url": "data/crash_data_queensland_1_crash_locations_trimmed.csv" },
          "title": {
            "text": "Monthly Crashes by Severity",
            "anchor": "start",
            "subtitle": [
              "Stacked bars show monthly crash counts by severity; green rule = mean total. Click bars/legend to highlight.",
              "Why: Spot seasonality and severity mix. Look for peaks and months above the mean."
            ]
          },
          "transform": [
            { "calculate": "toNumber(datum.Crash_Year)", "as": "YearNum" },
            { "filter": "isValid(datum.YearNum) && datum.YearNum >= yearStart && datum.YearNum <= yearEnd" },
            { "calculate": "indexof(lower(datum.Crash_Severity), 'fatal')>=0 ? 'Fatal' : indexof(lower(datum.Crash_Severity), 'hospital')>=0 ? 'Hospital' : indexof(lower(datum.Crash_Severity), 'medical')>=0 ? 'Medical' : indexof(lower(datum.Crash_Severity), 'minor')>=0 ? 'Minor' : 'Property'", "as": "SeverityNorm" },
            { "filter": "sevTop == 'All' || datum.SeverityNorm == sevTop" },
            { "filter": "(lgaSelect == 'All' || indexof(lower(datum.Loc_Local_Government_Area), lower(lgaSelect)) >= 0)" },
            { "filter": "typeFilter == 'All' || indexof(lower(datum.Crash_Type), lower(typeFilter)) >= 0" },
            { "filter": "natureFilter == 'All' || indexof(lower(datum.Crash_Nature), lower(natureFilter)) >= 0" },
            { "calculate": "datum.Count_Casualty_Total || datum.Total_Casualties || datum.Casualties || datum['Count Casualty Total'] || datum.count_casualty_total", "as": "CasTotalRaw" },
            { "calculate": "floor(toNumber(datum.CasTotalRaw))", "as": "CasTotalInt" },
            { "filter": "casBucket == 'All' || (casBucket == '1' && datum.CasTotalInt == 1) || (casBucket == '2-5' && datum.CasTotalInt >= 2 && datum.CasTotalInt <= 5) || (casBucket == '5-10' && datum.CasTotalInt >= 5 && datum.CasTotalInt <= 10) || (casBucket == '10-15' && datum.CasTotalInt >= 10 && datum.CasTotalInt <= 15) || (casBucket == '15-20' && datum.CasTotalInt >= 15 && datum.CasTotalInt <= 20) || (casBucket == '20+' && datum.CasTotalInt >= 20)" }
          ],
          "layer": [
            {
              "transform": [
                { "calculate": "datum.Crash_Month != null ? datum.Crash_Month : (datum['Crash Month'] != null ? datum['Crash Month'] : (datum.Month != null ? datum.Month : datum.month))", "as": "MonthRaw" },
                { "calculate": "toNumber(datum.MonthRaw)", "as": "MonthIndex" },
                { "calculate": "(isValid(datum.MonthIndex) && datum.MonthIndex>=1 && datum.MonthIndex<=12) ? ['January','February','March','April','May','June','July','August','September','October','November','December'][datum.MonthIndex-1] : datum.MonthRaw", "as": "MonthName" },
                { "aggregate": [{ "op": "count", "as": "CrashCount" }], "groupby": ["MonthName", "SeverityNorm"] },
                { "joinaggregate": [{ "op": "sum", "field": "CrashCount", "as": "MonthTotal" }], "groupby": ["MonthName"] },
                { "calculate": "datum.CrashCount / datum.MonthTotal", "as": "Share" }
              ],
              "mark": { "type": "bar" },
              "encoding": {
                "y": {
                  "field": "MonthName",
                  "type": "ordinal",
                  "sort": [
                    "January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"
                  ],
                  "title": "Month"
                },
                "x": { "field": "CrashCount", "type": "quantitative", "title": "Crash count" },
                "color": {
                  "field": "SeverityNorm",
                  "type": "nominal",
                  "title": "Severity",
                  "legend": null,
                  "scale": {
                    "domain": ["Fatal", "Hospital", "Medical", "Minor", "Property"],
                    "range": ["#dc2626", "#f97316", "#22c55e", "#3b82f6", "#94a3b8"]
                  }
                },
                "opacity": { "value": 0.85 },
                "tooltip": [
                  { "field": "MonthName", "type": "nominal", "title": "Month" },
                  { "field": "SeverityNorm", "type": "nominal", "title": "Severity" },
                  { "field": "CrashCount", "type": "quantitative", "title": "Crashes", "format": ",d" },
                  { "field": "MonthTotal", "type": "quantitative", "title": "Month total", "format": ",d" },
                  { "field": "Share", "type": "quantitative", "title": "Share of month", "format": ".0%" }
                ]
              }
            },
            {
              "transform": [
                { "calculate": "datum.Crash_Month != null ? datum.Crash_Month : (datum['Crash Month'] != null ? datum['Crash Month'] : (datum.Month != null ? datum.Month : datum.month))", "as": "MonthRaw" },
                { "calculate": "toNumber(datum.MonthRaw)", "as": "MonthIndex" },
                { "calculate": "(isValid(datum.MonthIndex) && datum.MonthIndex>=1 && datum.MonthIndex<=12) ? ['January','February','March','April','May','June','July','August','September','October','November','December'][datum.MonthIndex-1] : datum.MonthRaw", "as": "MonthName" },
                { "aggregate": [{ "op": "count", "as": "TotalCrashes" }], "groupby": ["MonthName"] }
              ],
              "mark": { "type": "line", "color": "#334155", "strokeWidth": 2, "opacity": 0.9, "point": true },
              "encoding": {
                "y": {
                  "field": "MonthName",
                  "type": "ordinal",
                  "sort": [
                    "January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"
                  ]
                },
                "x": { "field": "TotalCrashes", "type": "quantitative", "title": "Total crashes (line)" },
                "tooltip": [
                  { "field": "MonthName", "title": "Month" },
                  { "field": "TotalCrashes", "title": "Total", "format": ",d" }
                ]
              }
            },
            {
              "transform": [
                { "calculate": "datum.Crash_Month != null ? datum.Crash_Month : (datum['Crash Month'] != null ? datum['Crash Month'] : (datum.Month != null ? datum.Month : datum.month))", "as": "MonthRaw" },
                { "calculate": "toNumber(datum.MonthRaw)", "as": "MonthIndex" },
                { "calculate": "(isValid(datum.MonthIndex) && datum.MonthIndex>=1 && datum.MonthIndex<=12) ? ['January','February','March','April','May','June','July','August','September','October','November','December'][datum.MonthIndex-1] : datum.MonthRaw", "as": "MonthName" },
                { "aggregate": [{ "op": "count", "as": "TotalCrashes" }], "groupby": ["MonthName"] },
                { "aggregate": [{ "op": "mean", "field": "TotalCrashes", "as": "AvgTotal" }] }
              ],
              "mark": { "type": "rule", "color": "#10b981", "strokeWidth": 2, "opacity": 0.8 },
              "encoding": { "x": { "field": "AvgTotal", "type": "quantitative", "title": null } }
            },
            {
              "transform": [
                { "calculate": "datum.Crash_Month != null ? datum.Crash_Month : (datum['Crash Month'] != null ? datum['Crash Month'] : (datum.Month != null ? datum.Month : datum.month))", "as": "MonthRaw" },
                { "calculate": "toNumber(datum.MonthRaw)", "as": "MonthIndex" },
                { "calculate": "(isValid(datum.MonthIndex) && datum.MonthIndex>=1 && datum.MonthIndex<=12) ? ['January','February','March','April','May','June','July','August','September','October','November','December'][datum.MonthIndex-1] : datum.MonthRaw", "as": "MonthName" },
                { "aggregate": [{ "op": "count", "as": "TotalCrashes" }], "groupby": ["MonthName"] },
                { "aggregate": [{ "op": "mean", "field": "TotalCrashes", "as": "AvgTotal" }] }
              ],
              "mark": { "type": "text", "align": "left", "baseline": "bottom", "dx": 6, "dy": -2, "fontWeight": "bold", "color": "#10b981" },
              "encoding": {
                "x": { "field": "AvgTotal", "type": "quantitative" },
                "y": { "datum": "December" },
                "text": { "value": "Mean" }
              }
            },
            {
              "transform": [
                { "calculate": "datum.Crash_Month != null ? datum.Crash_Month : (datum['Crash Month'] != null ? datum['Crash Month'] : (datum.Month != null ? datum.Month : datum.month))", "as": "MonthRaw" },
                { "calculate": "toNumber(datum.MonthRaw)", "as": "MonthIndex" },
                { "calculate": "(isValid(datum.MonthIndex) && datum.MonthIndex>=1 && datum.MonthIndex<=12) ? ['January','February','March','April','May','June','July','August','September','October','November','December'][datum.MonthIndex-1] : datum.MonthRaw", "as": "MonthName" },
                { "aggregate": [{ "op": "count", "as": "CrashCount" }], "groupby": ["MonthName"] },
                { "window": [{ "op": "rank", "as": "rank" }], "sort": [{ "field": "CrashCount", "order": "descending" }] },
                { "filter": "datum.rank == 1" }
              ],
              "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 6, "fontWeight": "bold", "color": "#ef4444" },
              "encoding": {
                "y": {
                  "field": "MonthName",
                  "type": "ordinal",
                  "sort": [
                    "January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"
                  ]
                },
                "x": { "field": "CrashCount", "type": "quantitative" },
                "text": { "value": "Peak month" }
              }
            }
          ]
        },
        {
          "width": 400,
          "height": 280,
          "data": { "url": "data/crash_data_queensland_1_crash_locations_trimmed.csv" },
          "title": {
            "text": "Crash Type × Crash Nature Matrix",
            "anchor": "start",
            "subtitle": [
              "Heatmap of crash counts by Type × Nature, sorted by totals. Click a cell to highlight; counts overlaid.",
              "Why: Find high-risk combos. Look for darker cells and row/column leaders under filters."
            ]
          },
          "transform": [
            { "calculate": "toNumber(datum.Crash_Year)", "as": "YearNum" },
            { "filter": "isValid(datum.YearNum) && datum.YearNum >= yearStart && datum.YearNum <= yearEnd" },
            { "calculate": "indexof(lower(datum.Crash_Severity), 'fatal')>=0 ? 'Fatal' : indexof(lower(datum.Crash_Severity), 'hospital')>=0 ? 'Hospital' : indexof(lower(datum.Crash_Severity), 'medical')>=0 ? 'Medical' : indexof(lower(datum.Crash_Severity), 'minor')>=0 ? 'Minor' : 'Property'", "as": "SeverityNorm" },
            { "filter": "sevTop == 'All' || datum.SeverityNorm == sevTop" },
            { "filter": "(lgaSelect == 'All' || indexof(lower(datum.Loc_Local_Government_Area), lower(lgaSelect)) >= 0)" },
            { "filter": "typeFilter == 'All' || indexof(lower(datum.Crash_Type), lower(typeFilter)) >= 0" },
            { "filter": "natureFilter == 'All' || indexof(lower(datum.Crash_Nature), lower(natureFilter)) >= 0" }
          ],
          "layer": [
            {
              "transform": [
                { "aggregate": [{ "op": "count", "as": "CrashCount" }], "groupby": ["Crash_Type", "Crash_Nature"] },
                { "joinaggregate": [{ "op": "sum", "field": "CrashCount", "as": "TypeTotal" }], "groupby": ["Crash_Type"] },
                { "joinaggregate": [{ "op": "sum", "field": "CrashCount", "as": "NatureTotal" }], "groupby": ["Crash_Nature"] },
                { "window": [{ "op": "rank", "as": "cellRank" }], "sort": [{ "field": "CrashCount", "order": "descending" }] }
              ],
              "params": [
                { "name": "matrixSel", "select": { "type": "point", "fields": ["Crash_Type", "Crash_Nature"], "toggle": true } }
              ],
              "mark": { "type": "rect" },
              "encoding": {
                "x": { "field": "Crash_Type", "type": "nominal", "title": "Crash Type", "sort": { "field": "TypeTotal", "order": "descending" } },
                "y": { "field": "Crash_Nature", "type": "nominal", "title": "Crash Nature", "sort": { "field": "NatureTotal", "order": "descending" } },
                "color": {
                  "field": "CrashCount",
                  "type": "quantitative",
                  "title": "Crash count",
                  "scale": { "scheme": "redgrey", "reverse": true, "domainMin": 0 },
                  "legend": {
                    "orient": "right",
                    "format": ",d",
                    "gradientLength": 220,
                    "titleFontSize": 12,
                    "labelFontSize": 11
                  }
                },
                "opacity": { "condition": { "param": "matrixSel", "value": 1 }, "value": 0.6 },
                "tooltip": [
                  { "field": "Crash_Type", "title": "Type" },
                  { "field": "Crash_Nature", "title": "Nature" },
                  { "field": "CrashCount", "title": "Crashes", "format": ",d" },
                  { "field": "TypeTotal", "title": "Type total", "format": ",d" },
                  { "field": "NatureTotal", "title": "Nature total", "format": ",d" }
                ]
              }
            },
            {
              "transform": [
                { "aggregate": [{ "op": "count", "as": "CrashCount" }], "groupby": ["Crash_Type", "Crash_Nature"] },
                { "joinaggregate": [{ "op": "sum", "field": "CrashCount", "as": "TypeTotal" }], "groupby": ["Crash_Type"] },
                { "joinaggregate": [{ "op": "sum", "field": "CrashCount", "as": "NatureTotal" }], "groupby": ["Crash_Nature"] },
                { "window": [{ "op": "rank", "as": "cellRank" }], "sort": [{ "field": "CrashCount", "order": "descending" }] }
              ],
              "mark": { "type": "text", "font": "Segoe UI", "fontSize": 10, "fontWeight": 100, "fill": "#111827", "stroke": "white", "strokeWidth": 1 },
              "encoding": {
                "x": { "field": "Crash_Type", "type": "nominal", "sort": { "field": "TypeTotal", "order": "descending" } },
                "y": { "field": "Crash_Nature", "type": "nominal", "sort": { "field": "NatureTotal", "order": "descending" } },
                "text": { "field": "CrashCount", "type": "quantitative", "format": ",d" }
              }
            },
            {
              "transform": [
                { "aggregate": [{ "op": "count", "as": "CrashCount" }], "groupby": ["Crash_Type", "Crash_Nature"] },
                { "window": [{ "op": "rank", "as": "cellRank" }], "sort": [{ "field": "CrashCount", "order": "descending" }] },
                { "filter": "datum.cellRank <= 3" }
              ],
              "mark": { "type": "text", "align": "left", "baseline": "top", "dx": 4, "dy": 4, "font": "Segoe UI", "fontSize": 3, "color": "#ffffff" },
              "encoding": {
                "x": { "field": "Crash_Type", "type": "nominal" },
                "y": { "field": "Crash_Nature", "type": "nominal" }
              }
            }
          ]
        }
      ]
    }
  ]
}
